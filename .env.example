# Django application settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
# Comma-separated hostnames or IP addresses, without a URL scheme.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS and browser security
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# PostgreSQL connection
DB_NAME=gymms_db
DB_USER=postgres
DB_PASSWORD='db-password-here'
DB_HOST=db
DB_PORT=5432

# PayMongo QR payments
PAYMONGO_ENABLED=False
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
PAYMONGO_SECRET_KEY_TEST=
PAYMONGO_SECRET_KEY_LIVE=
PAYMONGO_WEBHOOK_SECRET_TEST=
PAYMONGO_WEBHOOK_SECRET_LIVE=
PAYMONGO_QR_EXPIRY_SECONDS=1800
PAYMONGO_CONNECT_TIMEOUT=5
PAYMONGO_READ_TIMEOUT=15
PAYMONGO_RECONCILE_INTERVAL=60
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
