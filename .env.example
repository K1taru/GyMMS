# Local development defaults. Copy to .env and replace database credentials.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False

DB_NAME=gymms_db
DB_USER=gymms_user
DB_PASSWORD=change-this-local-password
DB_HOST=db
DB_PORT=5432

# PayMongo QR Ph stays disabled until credentials and webhook subscriptions are ready.
PAYMONGO_ENABLED=False
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=
# Optional separate credentials let already-issued test/live attempts reconcile across a mode switch.
PAYMONGO_SECRET_KEY_TEST=
PAYMONGO_SECRET_KEY_LIVE=
PAYMONGO_WEBHOOK_SECRET_TEST=
PAYMONGO_WEBHOOK_SECRET_LIVE=
PAYMONGO_QR_EXPIRY_SECONDS=1800
PAYMONGO_CONNECT_TIMEOUT=5
PAYMONGO_READ_TIMEOUT=15
PAYMONGO_RECONCILE_INTERVAL=60
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300

# Actual ENV creds
DEBUG=True
SECRET_KEY='key here'

DB_NAME=gymms_db
DB_USER=postgres
DB_PASSWORD='pass here'
DB_HOST=db
DB_PORT=5432

DJANGO_ALLOWED_HOSTS=gymms.k1taru.space,www.gymms.space,gymms.space,gymms.gymms.space,192.168.254.24,localhost,127.0.0.1
