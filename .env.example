# Safe template only. Real credentials belong in the ignored .env file.
# Docker and Django read .env, not this template.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production: DEBUG=False, a strong Django key, public hostname/origin, redirect=True.
DJANGO_SECURE_SSL_REDIRECT=False

DB_NAME=gymms_db
DB_USER=gymms_user
DB_PASSWORD=replace-with-your-database-password
# Compose service name. Local tests must use their separate test settings.
DB_HOST=db
DB_PORT=5432

# Disable new QR checkouts until account, keys, webhook, and worker are ready.
PAYMONGO_ENABLED=False
PAYMONGO_MODE=test
# Optional fallback key for the selected mode. Mode-specific keys take precedence.
PAYMONGO_SECRET_KEY=
PAYMONGO_SECRET_KEY_TEST=
PAYMONGO_SECRET_KEY_LIVE=
# Signing secrets belong to each registered webhook endpoint, not the API key.
PAYMONGO_WEBHOOK_SECRET_TEST=
PAYMONGO_WEBHOOK_SECRET_LIVE=
PAYMONGO_QR_EXPIRY_SECONDS=1800
PAYMONGO_CONNECT_TIMEOUT=5
PAYMONGO_READ_TIMEOUT=15
PAYMONGO_RECONCILE_INTERVAL=60
PAYMONGO_WEBHOOK_TOLERANCE_SECONDS=300
