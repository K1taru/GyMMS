[Unit]
Description=GyMMS CI/CD deployment of verified releases
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/gymms-deploy /etc/gymms/deploy.conf
Environment=HOME=/var/lib/gymms-deploy
Environment=DOCKER_CONFIG=/var/lib/gymms-deploy/docker
StateDirectory=gymms-deploy
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
